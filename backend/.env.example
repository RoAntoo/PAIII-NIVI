# Reference only: Spring reads process environment; this file is not loaded automatically.
SERVER_PORT=8081
DB_URL=jdbc:h2:file:~/db/proyecto-db
DB_USERNAME=sa
DB_PASSWORD=
DDL_AUTO=update
AUTH_USERNAME=replace-with-your-local-user
AUTH_PASSWORD=replace-with-a-password-of-at-least-12-characters
# Generate at least 32 random bytes. Never use this example as a signing key.
AUTH_JWT_SECRET=replace-with-a-random-signing-key
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,https://localhost
